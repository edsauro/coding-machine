+    assert main(["--sprint", "S1", "aprovar", "S1", "--por", ""]) == 2
+    assert "--por" in capsys.readouterr().out
+
+
+def test_aprovar_recusa_sprints_divergentes(tmp_path, monkeypatch, capsys):
+    _sprint(tmp_path, "S1")
+    _sprint(tmp_path, "S2")
+    monkeypatch.setattr("autodev.cli.RAIZ", tmp_path)
