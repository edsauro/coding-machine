+    monkeypatch.setattr("autodev.cli.RAIZ", tmp_path)
+    assert main(["--sprint", "S1", "run", "--modo-teste"]) == 2
+    saida = capsys.readouterr().out
+    assert "sprint invalido" in saida
+    assert "Traceback" not in saida
+
