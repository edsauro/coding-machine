/usr/bin/bash -lc "python3 - <<'PY'
import contextlib
import io
import json
import tempfile
from pathlib import Path
from autodev import cli

with tempfile.TemporaryDirectory() as directory:
    root = Path(directory)
    sprint = root / '.autodev' / 'sprints' / 'S-INVALIDO'
    sprint.mkdir(parents=True)
    (sprint / 'dag.json').write_text('[]', encoding='utf-8')
    original = cli.RAIZ
    cli.RAIZ = root
    output = io.StringIO()
    try:
        with contextlib.redirect_stdout(output):
            code = cli.main(['prever', 'S-INVALIDO', '--json'])
    finally:
        cli.RAIZ = original
    assert code == 1
    assert 'não foi possível prever' in json.loads(output.getvalue())['erro']
print('malformed DAG handled without traceback')
