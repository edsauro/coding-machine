/usr/bin/bash -lc "ls -ld .venv 2>/dev/null || true
python3 - <<'PY'
import contextlib
import io
import json
import tempfile
from pathlib import Path
from autodev import cli


def invoke(root, sprint_id, dag, use_json=False):
    sprint = root / '.autodev' / 'sprints' / sprint_id
    sprint.mkdir(parents=True)
    (sprint / 'dag.json').write_text(dag, encoding='utf-8')
    output = io.StringIO()
    original = cli.RAIZ
    cli.RAIZ = root
    try:
        with contextlib.redirect_stdout(output):
            code = cli.main(['prever', sprint_id] + (['--json'] if use_json else []))
    finally:
        cli.RAIZ = original
    return code, output.getvalue()

with tempfile.TemporaryDirectory() as directory:
    root = Path(directory)
    code, output = invoke(root, 'S-LISTA', '[]', True)
    assert code == 1 and 'não foi possível prever' in json.loads(output)['erro']
    code, output = invoke(root, 'S-JSON', '{oops')
    assert code == 1 and 'não foi possível prever' in output
    code, output = invoke(root, 'S-SEM-ARQUIVO', json.dumps({
        'sprint_id': 'S-SEM-ARQUIVO', 'versao': 1,
        'criterio_paralelizacao': 'dependências definem as ondas',
        'tasks': [{'id': 'P01', 'titulo': 'sem arquivo',
                   'criterios': ['implementa a lógica'], 'deps': [],
                   'agente': 'codex', 'paralelizavel': True,
                   'estimativa': 'S', 'teste': ''}],
    }))
    assert code == 0
    assert '(sem arquivo nomeado)' in output
    assert 'colisões:\\n  nenhuma' in output
    assert 'tasks sem arquivo nomeado: P01' in output
print('manual regression scenarios passed')
