import contextlib
import io
import json
import tempfile
from pathlib import Path
from autodev import cli

with tempfile.TemporaryDirectory() as raiz_texto:
    raiz = Path(raiz_texto)
    sprint = \"S-COLISAO\"
    diretorio = raiz / \".autodev\" / \"sprints\" / sprint
    diretorio.mkdir(parents=True)
    dag = {\"tasks\": [
        {\"id\": \"P01\", \"titulo\": \"P01\", \"criterios\": [\"altera autodev/config.py\"]},
        {\"id\": \"P02\", \"titulo\": \"P02\", \"criterios\": [\"altera autodev/config.py\"]},
    ]}
    (diretorio / \"dag.json\").write_text(json.dumps(dag), encoding=\"utf-8\")
    anterior = cli.RAIZ
    cli.RAIZ = raiz
    try:
        saida = io.StringIO()
        with contextlib.redirect_stdout(saida):
            assert cli.main([\"--sprint\", sprint, \"init\"]) == 1
        assert \"P01\" in saida.getvalue() and \"P02\" in saida.getvalue()
        assert \"autodev/config.py\" in saida.getvalue()
    finally:
        cli.RAIZ = anterior
print(\"integração init: OK\")
