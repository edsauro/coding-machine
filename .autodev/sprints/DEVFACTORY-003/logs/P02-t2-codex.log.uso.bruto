+# Referências textuais a arquivos.  O planejador e o validador do motor usam a
+# mesma regra para que um plano aprovado não mude de significado no `init`.
+_ARQUIVO = re.compile(
+    r"(?<![\w.])(?:[\w.-]+/)*[\w-]+(?:\.[\w-]+)*\.[A-Za-z][A-Za-z0-9]*\b"
+    r"|\b(?:Makefile|Dockerfile)\b"
