import tempfile, json
from pathlib import Path
import autodev.cli as cli
from autodev.orchestrator import Orquestrador
with tempfile.TemporaryDirectory() as x:
 p=Path(x); d=p/'.autodev'/'sprints'/'S1'; d.mkdir(parents=True)
 (d/'dag.json').write_text(json.dumps({'sprint_id':'S1','tasks':[]}))
 (d/'sprint.yaml').write_text('sprint_id: S1\\nobjetivo: x\\nstatus: PLANEJADO\\n')
