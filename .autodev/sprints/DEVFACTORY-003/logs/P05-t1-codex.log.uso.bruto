+    }
+    with yaml_path.open("w", encoding="utf-8") as fh:
+        yaml.safe_dump(sprint, fh, allow_unicode=True, sort_keys=False)
+    print(f"sprint {args.sprint_id} aprovado por {args.por}")
+    return 0
+
+
 def cmd_resume(args) -> int:
