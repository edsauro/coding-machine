 (d/'dag.json').write_text('{\"sprint_id\":\"S1\",\"tasks\":[{\"id\":\"P1\",\"titulo\":\"x\",\"criterios\":[\"x\"]}]}')
 o=Orquestrador(p,'S1',modo_teste=True); r=o.rodar(); print('DIVERGENCIA:',r.parado_por); o.store.close()
