+    yaml_path = d / "sprint.yaml"
+    dag_path = d / "dag.json"
+    if not yaml_path.exists() or not dag_path.exists():
+        print(f"sprint inexistente ou incompleto: {args.sprint_id}")
+        return 1
+    with yaml_path.open(encoding="utf-8") as fh:
+        sprint = yaml.safe_load(fh) or {}
