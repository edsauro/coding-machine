index 897c946..a1ae450 100644
--- i/autodev/config.py
+++ w/autodev/config.py
@@ -17,11 +17,12 @@ RAIZ = Path(__file__).resolve().parent.parent
 AUTODEV = RAIZ / ".autodev"
 CONFIG = AUTODEV / "config"
 
-# Referências textuais a arquivos.  O planejador e o validador do motor usam a
