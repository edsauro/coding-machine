from autodev.planner import Plano, TaskPlano, colisoes_de_arquivo, avisos_de_colisao_de_arquivo, validar_plano

def plan(*tasks): return Plano('t', 'o', '.', list(tasks), '')
def task(id, criterion, deps=(), test=''):
    return TaskPlano(id, id, [criterion], list(deps), teste=test)

same = plan(task('P01', 'altera autodev/modulo.py'), task('P02', 'altera autodev/modulo.py'))
assert colisoes_de_arquivo(same) == [{'task_a': 'P01', 'task_b': 'P02', 'arquivo': 'autodev/modulo.py', 'onda': 1}]
assert any('P01' in e and 'P02' in e and 'autodev/modulo.py' in e for e in validar_plano(same))
serial = plan(task('P01', 'altera autodev/modulo.py'), task('P02', 'altera autodev/modulo.py', ('P01',)))
assert colisoes_de_arquivo(serial) == []
assert avisos_de_colisao_de_arquivo(serial) == [{'task_a': 'P01', 'task_b': 'P02', 'arquivo': 'autodev/modulo.py', 'onda': 1}]
tests = plan(task('P01', 'confira tests/test_plano.py'), task('P02', 'consulte tests/test_plano.py', ('P01',)))
assert colisoes_de_arquivo(tests) == [{'task_a': 'P01', 'task_b': 'P02', 'arquivo': 'tests/test_plano.py', 'onda': 1}]
mention = plan(task('P01', 'usa importada de autodev/modulo.py sem reimplementar'), task('P02', 'altera autodev/modulo.py'))
assert colisoes_de_arquivo(mention) == [] and validar_plano(mention) == []
dup = plan(task('P01', 'altera autodev/primeiro.py'), task('P01', 'altera autodev/segundo.py'))
assert colisoes_de_arquivo(dup) == []
cycle = plan(task('P01', 'altera autodev/primeiro.py', ('P02',)), task('P02', 'altera autodev/segundo.py', ('P01',)))
assert colisoes_de_arquivo(cycle) == []
print('checagem direta: OK')
