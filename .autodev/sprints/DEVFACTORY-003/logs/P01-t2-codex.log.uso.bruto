/usr/bin/bash -lc "sed -n '1,220p' /home/saurus/.codex/skills/verification-before-completion/SKILL.md && git diff --stat && git diff --check && python3 - <<'PY'
from autodev.planner import Plano, TaskPlano, colisoes_de_arquivo, avisos_de_colisao_de_arquivo, validar_plano

def make(*rows):
    return Plano('t', 'o', '.', [TaskPlano(*row) for row in rows], '')
# TaskPlano: id, titulo, criterios, deps, agente, teste
same = make(('A', 'A', ['altera pacote/modulo.py'], [], 'codex', ''), ('B', 'B', ['altera pacote/modulo.py'], [], 'codex', ''))
assert len(colisoes_de_arquivo(same)) == 1
serial = make(('A', 'A', ['altera pacote/modulo.py'], [], 'codex', ''), ('B', 'B', ['altera pacote/modulo.py'], ['A'], 'codex', ''))
assert not colisoes_de_arquivo(serial) and len(avisos_de_colisao_de_arquivo(serial)) == 1
shared_test = make(('A', 'A', ['consulta tests/test_unico.py'], [], 'codex', ''), ('B', 'B', ['consulta tests/test_unico.py'], ['A'], 'codex', ''))
assert len(colisoes_de_arquivo(shared_test)) == 1
assert validar_plano(same)[-1] == 'colisão de arquivo entre A e B: pacote/modulo.py (onda 1)'
print('casos de colisão: OK')
