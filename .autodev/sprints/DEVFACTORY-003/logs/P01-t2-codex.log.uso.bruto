+def _tem_intencao_de_edicao(texto: str) -> bool:
+    texto_normalizado = texto.casefold()
+    return (
+        not any(negacao in texto_normalizado for negacao in _NEGACOES_EDICAO)
+        and _PADRAO_EDICAO.search(texto) is not None
+    )
