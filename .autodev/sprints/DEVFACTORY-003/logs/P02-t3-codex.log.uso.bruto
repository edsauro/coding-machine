from pathlib import Path
from autodev.config import carrega_dag, valida_dag

def task(id_, criterio):
    return {'id': id_, 'titulo': id_, 'criterios': [criterio], 'deps': []}

cases = [
    ('texto', {'tasks': [task('P01', 'cobre item 3.a'), task('P02', 'documenta item 3.a')]}, []),
    ('registro', {'tasks': [task('P01', 'registra .autodev/sprints/S-1/decisions.md'), task('P02', 'registra .autodev/sprints/S-1/decisions.md')]}, []),
    ('onda', {'tasks': [task('P01', 'altera autodev/config.py'), task('P02', 'altera autodev/config.py')]}, ['colisão de arquivo entre P01 e P02: autodev/config.py (onda 1)']),
]
for nome, dag, esperado in cases:
    obtido = valida_dag(dag)
    print(nome, obtido)
    assert obtido == esperado
carrega_dag(Path('.autodev/sprints/DEVFACTORY-004/dag.json'))
print('DEVFACTORY-004: válido')
