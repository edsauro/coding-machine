/usr/bin/bash -lc "python3 - <<'PY'
import json
import tempfile
from contextlib import redirect_stdout
from io import StringIO
from pathlib import Path

from autodev import cli
from autodev.config import carrega_dag, valida_dag
from autodev.planner import Plano, TaskPlano, avisos_de_colisao_de_arquivo

def task(id_, criterio, deps=None):
    return {'id': id_, 'titulo': id_, 'criterios': [criterio], 'deps': deps or []}
def dag(*tasks): return {'tasks': list(tasks)}

assert valida_dag(dag(task('P01', 'altera autodev/config.py'), task('P02', 'altera autodev/config.py'))) == [
    'colisão de arquivo entre P01 e P02: autodev/config.py (onda 1)']
assert valida_dag(dag(task('P01', 'altera autodev/config.py'), task('P02', 'altera autodev/config.py', ['P01']))) == []
assert valida_dag(dag(task('P01', 'altera ./autodev/config.py'), task('P02', r'altera autodev\\config.py'))) == [
    'colisão de arquivo entre P01 e P02: autodev/config.py (onda 1)']
for texto in ('item 3.a', 'versao 1.b', 'e.g. isto'):
    assert valida_dag(dag(task('P01', texto), task('P02', texto))) == []
for arquivo in ('.autodev/sprints/S-1/decisions.md', '.autodev/sprints/S-1/logs/x.log', '.autodev/sprints/S-1/evidence/x.txt'):
    assert valida_dag(dag(task('P01', arquivo), task('P02', arquivo))) == []
plano = Plano('Teste', 'Teste', '.', [
    TaskPlano('P01', 'primeira', ['altera autodev/config.py']),
    TaskPlano('P02', 'segunda', ['altera autodev/config.py'], deps=['P01']),
], '')
assert avisos_de_colisao_de_arquivo(plano) == [{'task_a': 'P01', 'task_b': 'P02', 'arquivo': 'autodev/config.py', 'onda': 1, 'onda_b': 2}]
with tempfile.TemporaryDirectory(dir='/tmp') as tmp:
    raiz = Path(tmp)
    sprint = raiz / '.autodev/sprints/S-COLISAO'
    sprint.mkdir(parents=True)
    (sprint / 'dag.json').write_text(json.dumps(dag(task('P01', 'altera autodev/config.py'), task('P02', 'altera autodev/config.py'))))
    anterior, cli.RAIZ = cli.RAIZ, raiz
    try:
        saida = StringIO()
        with redirect_stdout(saida):
            codigo = cli.main(['--sprint', 'S-COLISAO', 'init'])
        assert codigo == 1
        assert all(item in saida.getvalue() for item in ('P01', 'P02', 'autodev/config.py'))
    finally:
        cli.RAIZ = anterior
carrega_dag(Path('.autodev/sprints/DEVFACTORY-004/dag.json'))
print('8 contratos comportamentais verificados; DEVFACTORY-004 carregável')
