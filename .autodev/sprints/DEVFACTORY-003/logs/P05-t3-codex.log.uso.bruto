+def cmd_aprovar(args) -> int:
+    if args.sprint is not None and args.sprint != args.sprint_id:
+        print(f"--sprint {args.sprint} diverge de sprint_id {args.sprint_id}")
+        return 2
+    if not args.por.strip():
