+        "quando": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
+        "hash_dag": hashlib.sha256(dag_path.read_bytes()).hexdigest(),
+    }
+    bloco = "aprovacao:\n" + "".join(
+        f"  {chave}: {json.dumps(valor, ensure_ascii=False)}\n"
+        for chave, valor in aprovacao.items())
