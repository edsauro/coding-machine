    (d / "sprint.yaml").write_text(
        f"sprint_id: {sprint}\ntitulo: teste\nobjetivo: {objetivo}\n"
        f"aprovacao:\n  por: teste\n  quando: fixture\n  hash_dag: {hash_dag}\n",
        encoding="utf-8")
    (d / "spec.md").write_text(f"# {sprint}\n\n{objetivo}\n", encoding="utf-8")
