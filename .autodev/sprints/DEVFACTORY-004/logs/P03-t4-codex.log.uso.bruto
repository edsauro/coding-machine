 ROOT = Path(__file__).parents[2]
+AFIRMACAO_COTA_CONFIGURADA = re.compile(
+    r"consom\w*\s+(?:a\s+)?cota\s+do\s+agente\s+configurado", re.IGNORECASE
+)
