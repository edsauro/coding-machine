+"""Tipos e persistência mínima do plano produzido pelo planejador."""
+from __future__ import annotations
+
+import json
+import re
+from dataclasses import asdict, dataclass, field
+from pathlib import Path
+
+
+class PlanoInvalido(ValueError):
+    pass
+
+
+class SprintJaExiste(FileExistsError):
+    pass
+
+
+@dataclass
+class TaskPlano:
+    id: str
+    titulo: str
+    criterios: list[str]
+    deps: list[str] = field(default_factory=list)
+    agente: str = "codex"
+    teste: str = ""
+
+
+@dataclass
+class Plano:
+    titulo: str
+    objetivo: str
+    repositorio: str
+    tasks: list[TaskPlano]
+    prompt_original: str = ""
+
+
+def _sprint_id(titulo: str) -> str:
+    valor = re.sub(r"[^A-Za-z0-9]+", "-", titulo).strip("-").upper()
+    return valor or "SPRINT-PLANEJADO"
+
+
+def escrever_sprint(raiz: str | Path, plano: Plano) -> Path:
+    raiz = Path(raiz)
+    sprint_id = _sprint_id(plano.titulo)
+    destino = raiz / ".autodev" / "sprints" / sprint_id
+    if destino.exists():
+        raise SprintJaExiste(f"sprint ja existe: {sprint_id}")
+    destino.mkdir(parents=True)
+    tasks = [asdict(task) for task in plano.tasks]
+    (destino / "dag.json").write_text(json.dumps({
+        "sprint_id": sprint_id, "versao": 1,
+        "prompt_original": plano.prompt_original or "", "tasks": tasks,
+    }, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+    (destino / "sprint.yaml").write_text(
+        f"sprint_id: {sprint_id}\ntitulo: {plano.titulo}\n"
+        f"objetivo: {plano.objetivo}\nstatus: PLANEJADO\n"
+        f"repositorio:\n  raiz: {plano.repositorio}\n  merge_em_main: false\n",
+        encoding="utf-8")
+    prompt = plano.prompt_original or "nao informado"
+    (destino / "spec.md").write_text(
+        f"# {plano.titulo}\n\n## Objetivo\n\n{plano.objetivo}\n\n"
+        f"## Prompt original\n\n{prompt}\n", encoding="utf-8")
+    return destino
