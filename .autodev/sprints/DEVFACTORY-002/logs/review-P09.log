diff --git a/.autodev/tests/test_plan_rastreabilidade.py b/.autodev/tests/test_plan_rastreabilidade.py
new file mode 100644
index 0000000..4aee82d
--- /dev/null
+++ b/.autodev/tests/test_plan_rastreabilidade.py
@@ -0,0 +1,102 @@
+"""Rastreabilidade do pedido original nos artefatos do planejamento."""
+
+from __future__ import annotations
+
+import json
+
+import pytest
+import yaml
+
+from autodev import cli
+from autodev.planner import Plano, TaskPlano, escrever_sprint
+
+
+def _plano(prompt: str) -> Plano:
+    return Plano(
+        titulo="Rastrear pedido",
+        objetivo="Preservar o contexto do planejamento",
+        repositorio=".",
+        tasks=[
+            TaskPlano(
+                id="P01",
+                titulo="Persistir contexto",
+                criterios=["dag.json registra o prompt original"],
+            )
+        ],
+        prompt_original=prompt,
+    )
+
+
+def test_escrever_sprint_preserva_prompt_literal_na_spec_e_no_dag(tmp_path):
+    prompt = "Crie o recurso exatamente assim:\n- não normalize  espaços"
+
+    destino = escrever_sprint(tmp_path, _plano(prompt))
+
+    spec = (destino / "spec.md").read_text(encoding="utf-8")
+    dag = json.loads((destino / "dag.json").read_text(encoding="utf-8"))
+    assert f"# Prompt original\n\n{prompt}\n\n" in spec
+    assert dag["prompt_original"] == prompt
+
+
+def _preparar_sprint_para_relatorio(raiz, dag: dict | None) -> None:
+    destino = raiz / ".autodev/sprints/DEVFACTORY-001"
+    destino.mkdir(parents=True)
+    (destino / "sprint.yaml").write_text(
+        yaml.safe_dump(
+            {"sprint_id": "DEVFACTORY-001", "objetivo": "Testar relatório"},
+            allow_unicode=True,
+        ),
+        encoding="utf-8",
+    )
+    if dag is not None:
+        (destino / "dag.json").write_text(
+            json.dumps(dag, ensure_ascii=False), encoding="utf-8"
+        )
+
+
+def test_comando_report_inclui_prompt_original_no_contexto(repo, monkeypatch):
+    prompt = "Implemente a auditoria\nsem alterar os testes existentes."
+    _preparar_sprint_para_relatorio(repo, {"tasks": [], "prompt_original": prompt})
+    monkeypatch.setattr(cli, "RAIZ", repo)
+
+    assert cli.main(["--sprint", "DEVFACTORY-001", "report"]) == 0
+
+    relatorio = (
+        repo / ".autodev/sprints/DEVFACTORY-001/SPRINT-REPORT.md"
+    ).read_text(encoding="utf-8")
+    contexto = relatorio.split("## Contexto do planejamento", 1)[1].split("## 1.", 1)[0]
+    assert prompt in contexto
+
+
+@pytest.mark.parametrize(
+    "dag",
+    [None, {"tasks": []}, {"tasks": [], "prompt_original": ""},
+     {"tasks": [], "prompt_original": None}],
+)
+def test_comando_report_aceita_prompt_original_nao_informado(repo, monkeypatch, dag):
+    _preparar_sprint_para_relatorio(repo, dag)
+    monkeypatch.setattr(cli, "RAIZ", repo)
+
+    assert cli.main(["--sprint", "DEVFACTORY-001", "report"]) == 0
+
+    relatorio = (
+        repo / ".autodev/sprints/DEVFACTORY-001/SPRINT-REPORT.md"
+    ).read_text(encoding="utf-8")
+    contexto = relatorio.split("## Contexto do planejamento", 1)[1].split("## 1.", 1)[0]
+    assert "Prompt original: não informado" in contexto
+
+
+def test_prompt_do_dag_prevalece_sobre_colisao_nos_extras(repo, monkeypatch):
+    prompt = "Pedido registrado no DAG"
+    _preparar_sprint_para_relatorio(repo, {"tasks": [], "prompt_original": prompt})
+    destino = repo / ".autodev/sprints/DEVFACTORY-001"
+    (destino / "report-extras.json").write_text(
+        json.dumps({"prompt_original": "valor conflitante"}), encoding="utf-8"
+    )
+    monkeypatch.setattr(cli, "RAIZ", repo)
+
+    assert cli.main(["--sprint", "DEVFACTORY-001", "report"]) == 0
+
+    relatorio = (destino / "SPRINT-REPORT.md").read_text(encoding="utf-8")
+    assert f"Prompt original: {prompt}" in relatorio
+    assert "valor conflitante" not in relatorio
