+import json
+
+import yaml
+
+from autodev import cli, worktree
+from autodev.planner import Plano, TaskPlano, escrever_sprint
+
+
+def _plano(prompt_original: str) -> Plano:
+    return Plano(
+        titulo="Plano rastreável",
+        objetivo="Preservar a origem do planejamento",
+        repositorio="projeto",
+        tasks=[
+            TaskPlano(
+                id="P01",
+                titulo="Registrar prompt",
+                criterios=["dag.json contém o prompt original"],
+            )
+        ],
+        prompt_original=prompt_original,
+    )
+
+
+def _preparar_sprint_para_relatorio(tmp_path, dag: dict) -> None:
+    diretorio = tmp_path / ".autodev" / "sprints" / "S1"
+    diretorio.mkdir(parents=True)
+    (diretorio / "sprint.yaml").write_text(
+        yaml.safe_dump({"sprint_id": "S1", "objetivo": "Rastrear o pedido"}),
+        encoding="utf-8",
+    )
+    (diretorio / "dag.json").write_text(
+        json.dumps(dag, ensure_ascii=False),
+        encoding="utf-8",
+    )
+
+
+def _gerar_relatorio_cli(tmp_path, monkeypatch) -> str:
+    monkeypatch.setattr(cli, "RAIZ", tmp_path)
+    monkeypatch.setattr(worktree, "commit_atual", lambda _raiz: "abc123")
+
+    assert cli.main(["--sprint", "S1", "report"]) == 0
+    return (
+        tmp_path / ".autodev" / "sprints" / "S1" / "SPRINT-REPORT.md"
+    ).read_text(encoding="utf-8")
+
+
+def test_escrever_sprint_preserva_prompt_literal_na_spec_e_no_dag(tmp_path):
+    prompt = "Crie uma API.\n\nNão normalize   estes espaços."
+
+    destino = escrever_sprint(tmp_path, _plano(prompt))
+
+    spec = (destino / "spec.md").read_text(encoding="utf-8")
+    dag = json.loads((destino / "dag.json").read_text(encoding="utf-8"))
+    assert f"# Prompt original\n\n{prompt}\n\n" in spec
+    assert dag["prompt_original"] == prompt
+
+
+def test_comando_report_inclui_prompt_do_dag_na_secao_de_contexto(
+    tmp_path, monkeypatch
+):
+    prompt = "Implemente rastreabilidade sem alterar o texto."
+    _preparar_sprint_para_relatorio(
+        tmp_path,
+        {"sprint_id": "S1", "tasks": [], "prompt_original": prompt},
+    )
+
+    relatorio = _gerar_relatorio_cli(tmp_path, monkeypatch)
+
+    contexto = relatorio.split("## Contexto do planejamento", 1)[1].split("## 1.", 1)[0]
+    assert prompt in contexto
+
+
+def test_comando_report_aceita_dag_sem_prompt_e_informa_ausencia(
+    tmp_path, monkeypatch
+):
+    _preparar_sprint_para_relatorio(tmp_path, {"sprint_id": "S1", "tasks": []})
+
+    relatorio = _gerar_relatorio_cli(tmp_path, monkeypatch)
+
+    contexto = relatorio.split("## Contexto do planejamento", 1)[1].split("## 1.", 1)[0]
+    assert "não informado" in contexto
