+"""Criação e persistência de planos de sprint."""
+from __future__ import annotations
+import json
+from dataclasses import dataclass, field
+from pathlib import Path
+import yaml
+from .config import ordem_topologica, valida_dag
+
+PALAVRAS_VAGAS = {"coisa", "algo", "melhorar", "ajustar", "implementar"}
+class PlanoInvalido(ValueError):
+    def __init__(self, erros): self.erros = list(erros); super().__init__("; ".join(self.erros))
+class SprintJaExiste(FileExistsError): pass
+class CotaEsgotada(RuntimeError): pass
+@dataclass
+class TaskPlano:
+    id: str; titulo: str; criterios: list[str]; deps: list[str] = field(default_factory=list); agente: str = "codex"; teste: str = ""
+@dataclass
+class Plano:
+    titulo: str; objetivo: str; repositorio: str; tasks: list[TaskPlano]; prompt_original: str
+def parsear_plano(texto):
+    try: data = yaml.safe_load(texto)
+    except yaml.YAMLError as exc: raise PlanoInvalido([f"plano não é YAML válido: {exc}"]) from exc
+    if not isinstance(data, dict): raise PlanoInvalido(["plano precisa ser um objeto YAML"])
+    return Plano(str(data.get("titulo", "")), str(data.get("objetivo", "")), str(data.get("repositorio", "")), [TaskPlano(str(t.get("id", "")), str(t.get("titulo", "")), list(t.get("criterios", [])), list(t.get("deps", [])), str(t.get("agente", "codex")), str(t.get("teste", ""))) for t in data.get("tasks", [])], str(data.get("prompt_original", "")))
+def validar_plano(plano):
+    erros=[]
+    if not plano.titulo.strip(): erros.append("titulo é obrigatório")
+    if not plano.objetivo.strip(): erros.append("objetivo é obrigatório")
+    if not plano.repositorio.strip(): erros.append("repositorio é obrigatório")
+    if not plano.tasks: erros.append("o plano precisa de ao menos uma task")
+    for task in plano.tasks:
+        for criterio in task.criterios:
+            if any(p in criterio.lower().split() for p in PALAVRAS_VAGAS): erros.append(f"task {task.id}: criterio vago: {criterio}")
+    dag={"tasks":[{"id":t.id,"titulo":t.titulo,"criterios":t.criterios,"deps":t.deps} for t in plano.tasks]}
+    erros.extend(valida_dag(dag)); return erros
+def validar_e_ordenar(plano):
+    erros=validar_plano(plano)
+    if erros: raise PlanoInvalido(erros)
+    return ordem_topologica({"tasks":[{"id":t.id,"deps":t.deps} for t in plano.tasks]})
+def escrever_sprint(raiz, plano):
+    validar_e_ordenar(plano); base=Path(raiz)/".autodev"/"sprints"; base.mkdir(parents=True, exist_ok=True)
+    n=1
+    while (base/(sid:=f"PLAN-{n:03d}")).exists(): n+=1
+    dest=base/sid; dest.mkdir()
+    (dest/"spec.md").write_text(f"# {plano.titulo}\n\n{plano.objetivo}\n", encoding="utf-8")
+    (dest/"dag.json").write_text(json.dumps({"sprint_id":sid,"tasks":[{"id":t.id,"titulo":t.titulo,"criterios":t.criterios,"deps":t.deps,"agente":t.agente,"teste":t.teste} for t in plano.tasks]}, ensure_ascii=False), encoding="utf-8")
+    (dest/"sprint.yaml").write_text(yaml.safe_dump({"sprint_id":sid,"titulo":plano.titulo,"objetivo":plano.objetivo}, allow_unicode=True, sort_keys=False), encoding="utf-8")
+    return dest
+def planejar(raiz, prompt_usuario, agente):
+    if not prompt_usuario.strip(): raise PlanoInvalido(["pedido não pode ser vazio"])
+    t=prompt_usuario.strip().splitlines()[0][:120]
+    return Plano(t, prompt_usuario.strip(), str(raiz), [TaskPlano("T01",t,["pedido atendido"], teste="pytest")], prompt_usuario)
