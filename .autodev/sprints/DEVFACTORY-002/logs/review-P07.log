+"""Prompt usado para transformar um pedido em um plano estruturado."""
+
+PROMPT_PLANO = """Converta o pedido do usuário em YAML com titulo, objetivo, repositorio e tasks.
+Cada task deve ter id, titulo, criterios, deps, agente e teste.
+Responda somente com o YAML do plano.
+"""
+
+
+def montar_prompt_plano(prompt_usuario: str) -> str:
+    return f"{PROMPT_PLANO}\nPedido do usuário:\n{prompt_usuario}"
diff --git a/autodev/planner.py b/autodev/planner.py
new file mode 100644
index 0000000..43fcf9d
--- /dev/null
+++ b/autodev/planner.py
@@ -0,0 +1,130 @@
+"""Criação e persistência de planos de sprint."""
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass, field
+from pathlib import Path
+
+import yaml
+
+from .config import ordem_topologica, valida_dag
+
+PALAVRAS_VAGAS = {"coisa", "algo", "melhorar", "ajustar", "implementar"}
+
+
+class PlanoInvalido(ValueError):
+    def __init__(self, erros: list[str]):
+        self.erros = list(erros)
+        super().__init__("; ".join(self.erros))
+
+
+class SprintJaExiste(FileExistsError):
+    pass
+
+
+class CotaEsgotada(RuntimeError):
+    pass
+
+
+@dataclass
+class TaskPlano:
+    id: str
+    titulo: str
+    criterios: list[str]
+    deps: list[str] = field(default_factory=list)
+    agente: str = "codex"
+    teste: str = ""
+
+
+@dataclass
+class Plano:
+    titulo: str
+    objetivo: str
+    repositorio: str
+    tasks: list[TaskPlano]
+    prompt_original: str
+
+
+def _task(data: dict) -> TaskPlano:
+    return TaskPlano(id=str(data.get("id", "")), titulo=str(data.get("titulo", "")),
+                     criterios=list(data.get("criterios", [])),
+                     deps=list(data.get("deps", [])), agente=str(data.get("agente", "codex")),
+                     teste=str(data.get("teste", "")))
+
+
+def parsear_plano(texto: str) -> Plano:
+    try:
+        data = yaml.safe_load(texto)
+    except yaml.YAMLError as exc:
+        raise PlanoInvalido([f"plano não é YAML válido: {exc}"]) from exc
+    if not isinstance(data, dict):
+        raise PlanoInvalido(["plano precisa ser um objeto YAML"])
+    return Plano(titulo=str(data.get("titulo", "")), objetivo=str(data.get("objetivo", "")),
+                 repositorio=str(data.get("repositorio", "")),
+                 tasks=[_task(t) for t in data.get("tasks", [])],
+                 prompt_original=str(data.get("prompt_original", "")))
+
+
+def validar_plano(plano: Plano) -> list[str]:
+    erros: list[str] = []
+    if not plano.titulo.strip():
+        erros.append("titulo é obrigatório")
+    if not plano.objetivo.strip():
+        erros.append("objetivo é obrigatório")
+    if not plano.repositorio.strip():
+        erros.append("repositorio é obrigatório")
+    if not plano.tasks:
+        erros.append("o plano precisa de ao menos uma task")
+    dag = {"tasks": [{"id": t.id, "titulo": t.titulo, "criterios": t.criterios,
+                       "deps": t.deps} for t in plano.tasks]}
+    erros.extend(valida_dag(dag))
+    return erros
+
+
+def validar_e_ordenar(plano: Plano) -> list[list[str]]:
+    erros = validar_plano(plano)
+    if erros:
+        raise PlanoInvalido(erros)
+    return ordem_topologica({"tasks": [{"id": t.id, "deps": t.deps} for t in plano.tasks]})
+
+
+def _novo_id(raiz: Path) -> str:
+    base = raiz / ".autodev" / "sprints"
+    existentes = {p.name for p in base.iterdir()} if base.exists() else set()
+    n = 1
+    while f"PLAN-{n:03d}" in existentes:
+        n += 1
+    return f"PLAN-{n:03d}"
+
+
+def escrever_sprint(raiz: Path, plano: Plano) -> Path:
+    validar_e_ordenar(plano)
+    raiz = Path(raiz)
+    sprint_id = _novo_id(raiz)
+    destino = raiz / ".autodev" / "sprints" / sprint_id
+    if destino.exists():
+        raise SprintJaExiste(sprint_id)
+    destino.mkdir(parents=True)
+    (destino / "spec.md").write_text(f"# {plano.titulo}\n\n{plano.objetivo}\n", encoding="utf-8")
+    dag = {"sprint_id": sprint_id, "tasks": [
+        {"id": t.id, "titulo": t.titulo, "criterios": t.criterios, "deps": t.deps,
+         "agente": t.agente, "teste": t.teste} for t in plano.tasks]}
+    (destino / "dag.json").write_text(json.dumps(dag, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+    (destino / "sprint.yaml").write_text(yaml.safe_dump(
+        {"sprint_id": sprint_id, "titulo": plano.titulo, "objetivo": plano.objetivo},
+        allow_unicode=True, sort_keys=False), encoding="utf-8")
+    return destino
+
+
+def planejar(raiz: Path, prompt_usuario: str, agente: str) -> Plano:
+    texto = prompt_usuario.strip()
+    if not texto:
+        raise PlanoInvalido(["pedido não pode ser vazio"])
+    titulo = texto.splitlines()[0].strip()[:120]
+    plano = Plano(titulo=titulo, objetivo=texto, repositorio=str(raiz),
+                  tasks=[TaskPlano("T01", titulo, ["pedido atendido"], teste="pytest")],
+                  prompt_original=prompt_usuario)
+    erros = validar_plano(plano)
+    if erros:
+        raise PlanoInvalido(erros)
+    return plano
