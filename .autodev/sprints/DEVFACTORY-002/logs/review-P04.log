@@ -0,0 +1,106 @@
+"""Tipos e validações do plano produzido pelo planejador."""
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+import re
+
+from .config import ordem_topologica
+
+
+PALAVRAS_VAGAS = ["melhorar", "otimizar", "refatorar", "revisar", "ajustar"]
+
+
+class PlanoInvalido(ValueError):
+    """Plano que não pode ser convertido em um DAG executável."""
+
+
+class SprintJaExiste(Exception):
+    pass
+
+
+class CotaEsgotada(Exception):
+    pass
+
+
+@dataclass
+class TaskPlano:
+    id: str
+    titulo: str
+    criterios: list[str]
+    deps: list[str] = field(default_factory=list)
+    agente: str = "codex"
+    teste: str = ""
+
+
+@dataclass
+class Plano:
+    titulo: str
+    objetivo: str
+    repositorio: str
+    tasks: list[TaskPlano]
+    prompt_original: str
+
+
+def _tem_evidencia(criterio: str) -> bool:
+    evidencia = r"(?:[\w./-]+\.(?:py|js|ts|json|yaml|yml|md|toml|sh)|pytest\b|python(?:3)?\s+-m\s+pytest\b)"
+    return bool(re.search(rf"(?:^|[\s`'\"]){evidencia}", criterio, re.IGNORECASE))
+
+
+def _ids_do_ciclo(tasks: list[TaskPlano]) -> list[str]:
+    grafo = {task.id: task.deps for task in tasks}
+    visitando: list[str] = []
+    visitados: set[str] = set()
+
+    def visitar(node: str) -> list[str] | None:
+        if node in visitando:
+            return visitando[visitando.index(node):] + [node]
+        if node in visitados:
+            return None
+        visitando.append(node)
+        for dep in grafo.get(node, []):
+            ciclo = visitar(dep)
+            if ciclo:
+                return ciclo
+        visitando.pop()
+        visitados.add(node)
+        return None
+
+    for task_id in grafo:
+        ciclo = visitar(task_id)
+        if ciclo:
+            return ciclo
+    return []
+
+
+def validar_plano(plano: Plano) -> list[str]:
+    erros: list[str] = []
+    if not plano.tasks:
+        return ["plano sem tasks"]
+    ids = [task.id for task in plano.tasks]
+    if len(ids) != len(set(ids)):
+        erros.append("ids duplicados no plano")
+    conhecidos = set(ids)
+    for task in plano.tasks:
+        if not task.criterios:
+            erros.append(f"task {task.id} sem criterios")
+        for dep in task.deps:
+            if dep not in conhecidos:
+                erros.append(f"task {task.id} depende de {dep}, que não existe")
+        for indice, criterio in enumerate(task.criterios):
+            if any(palavra in criterio.casefold() for palavra in PALAVRAS_VAGAS) and not _tem_evidencia(criterio):
+                erros.append(f"task {task.id}, critério {indice}: critério vago sem arquivo ou comando de teste")
+    ciclo = _ids_do_ciclo(plano.tasks)
+    if ciclo:
+        erros.append("ciclo entre tasks: " + " -> ".join(ciclo))
+    return erros
+
+
+def validar_e_ordenar(plano: Plano) -> list[list[str]]:
+    erros = validar_plano(plano)
+    if erros:
+        raise PlanoInvalido("Plano inválido:\n- " + "\n- ".join(erros))
+    dag = {"tasks": [{"id": task.id, "deps": task.deps} for task in plano.tasks]}
+    try:
+        return ordem_topologica(dag)
+    except ValueError as exc:
+        raise PlanoInvalido(str(exc)) from exc
