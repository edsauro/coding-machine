+def validar_e_ordenar(plano: Plano) -> list[list[str]]:
+    """Valida o plano e devolve suas ondas usando o ordenador do DAG real."""
+    erros = validar_plano(plano)
+    if erros:
+        raise PlanoInvalido("plano inválido:\n  - " + "\n  - ".join(erros))
+
+    dag = {
+        "tasks": [
+            {
+                "id": task.id,
+                "titulo": task.titulo,
+                "criterios": task.criterios,
+                "deps": task.deps,
+            }
+            for task in plano.tasks
+        ]
+    }
+    return ordem_topologica(dag)
