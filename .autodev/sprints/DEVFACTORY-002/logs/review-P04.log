 from __future__ import annotations
 
 import json
+import re
 from dataclasses import dataclass, field
 
+from .config import ordem_topologica
+
+
+PALAVRAS_VAGAS = ["melhorar", "otimizar", "refatorar", "revisar", "ajustar"]
+
+
+_ARQUIVO = re.compile(r"(?<!\w)(?:[\w.-]+/)*[\w.-]+\.[A-Za-z][A-Za-z0-9]*(?!\w)")
+_COMANDO_TESTE = re.compile(
+    r"\b(?:python3?\s+-m\s+pytest|pytest|npm\s+(?:run\s+)?test|"
+    r"yarn\s+test|pnpm\s+test|go\s+test|cargo\s+test|mvn\s+test|"
+    r"gradlew?\s+test)\b",
+    re.IGNORECASE,
+)
+
+
+def _criterio_vago(criterio: str) -> bool:
+    palavras = "|".join(re.escape(palavra) for palavra in PALAVRAS_VAGAS)
+    contem_palavra_vaga = re.search(rf"\b(?:{palavras})\b", criterio, re.IGNORECASE)
+    contem_evidencia = _ARQUIVO.search(criterio) or _COMANDO_TESTE.search(criterio)
+    return bool(contem_palavra_vaga and not contem_evidencia)
+
 
 @dataclass
 class TaskPlano:
