+"""Tipos e persistência do plano de uma sprint."""
+from __future__ import annotations
+
+import json
+import re
+from dataclasses import dataclass, field
+from pathlib import Path
+
+import yaml
+
+
+class SprintJaExiste(FileExistsError):
+    """O diretório do sprint já existe e não pode ser sobrescrito."""
+
+
+@dataclass
+class TaskPlano:
+    id: str
+    titulo: str
+    criterios: list[str]
+    deps: list[str] = field(default_factory=list)
+    agente: str = "codex"
+    teste: str = ""
+
+
+@dataclass
+class Plano:
+    titulo: str
+    objetivo: str
+    repositorio: str
+    tasks: list[TaskPlano]
+    prompt_original: str = ""
+
+
+def _sprint_id(plano: Plano) -> str:
+    slug = re.sub(r"[^A-Za-z0-9_-]+", "-", plano.titulo).strip("-").lower()
+    return slug or "sprint-planejado"
+
+
+def escrever_sprint(raiz: str | Path, plano: Plano) -> Path:
+    """Escreve os artefatos do plano, sem substituir um sprint existente."""
+    raiz = Path(raiz)
+    sprint_id = _sprint_id(plano)
+    destino = raiz / ".autodev" / "sprints" / sprint_id
+    if destino.exists():
+        raise SprintJaExiste(f"sprint já existe: {sprint_id}")
+
+    repositorio = {
+        "raiz": str(plano.repositorio or "."),
+        "merge_em_main": False,
+    }
+    tasks = [
+        {
+            "id": task.id,
+            "titulo": task.titulo,
+            "criterios": task.criterios,
+            "deps": task.deps,
+            "agente": task.agente,
+            "teste": task.teste,
+        }
+        for task in plano.tasks
+    ]
+    destino.mkdir(parents=True)
+    dag = {"sprint_id": sprint_id, "versao": 1, "tasks": tasks}
+    if plano.prompt_original:
+        dag["prompt_original"] = plano.prompt_original
+    (destino / "dag.json").write_text(
+        json.dumps(dag, ensure_ascii=False, indent=2) + "\n", encoding="utf-8"
+    )
+    sprint = {
+        "sprint_id": sprint_id,
+        "titulo": plano.titulo,
+        "objetivo": plano.objetivo,
+        "status": "PLANEJADO",
+        "repositorio": repositorio,
+    }
+    (destino / "sprint.yaml").write_text(
+        yaml.safe_dump(sprint, allow_unicode=True, sort_keys=False), encoding="utf-8"
+    )
+    prompt = plano.prompt_original or "não informado"
+    spec = f"## Prompt original\n\n{prompt}\n\n## Objetivo\n\n{plano.objetivo}\n"
+    (destino / "spec.md").write_text(spec, encoding="utf-8")
+    return destino
