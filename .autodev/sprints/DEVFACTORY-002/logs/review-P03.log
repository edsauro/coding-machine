+++ b/autodev/planner.py
@@ -0,0 +1,72 @@
+"""Modelos e parsing tolerante da resposta do agente planejador."""
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass, field
+
+
+class PlanoInvalido(ValueError):
+    """Resposta do agente que não contém um plano reconhecível."""
+
+
+@dataclass
+class TaskPlano:
+    id: str
+    titulo: str
+    criterios: list[str]
+    deps: list[str] = field(default_factory=list)
+    agente: str = "codex"
+    teste: str = ""
+
+
+@dataclass
+class Plano:
+    titulo: str
+    objetivo: str
+    repositorio: str
+    tasks: list[TaskPlano]
+    prompt_original: str = ""
+
+
+def _encontrar_json(texto: str) -> dict:
+    decodificador = json.JSONDecoder()
+    primeiro_objeto = None
+    for inicio, caractere in enumerate(texto):
+        if caractere != "{":
+            continue
+        try:
+            valor, _ = decodificador.raw_decode(texto[inicio:])
+        except json.JSONDecodeError:
+            continue
+        if isinstance(valor, dict):
+            primeiro_objeto = primeiro_objeto or valor
+            if "tasks" in valor:
+                return valor
+    if primeiro_objeto is not None:
+        return primeiro_objeto
+    raise PlanoInvalido("resposta não contém JSON reconhecível")
+
+
+def parsear_plano(texto: str) -> Plano:
+    """Converte JSON puro ou embutido em texto em um :class:`Plano`."""
+    try:
+        dados = _encontrar_json(texto)
+    except (TypeError, PlanoInvalido) as erro:
+        if isinstance(erro, PlanoInvalido):
+            raise
+        raise PlanoInvalido("resposta não contém JSON reconhecível") from erro
+
+    if "tasks" not in dados:
+        raise PlanoInvalido("JSON do plano não contém a chave tasks")
+
+    try:
+        tarefas = [TaskPlano(**task) for task in dados["tasks"]]
+        return Plano(
+            titulo=dados.get("titulo", ""),
+            objetivo=dados.get("objetivo", ""),
+            repositorio=dados.get("repositorio", ""),
+            tasks= tarefas,
+            prompt_original=texto,
+        )
+    except (TypeError, ValueError) as erro:
+        raise PlanoInvalido("JSON do plano possui tasks inválidas") from erro
```

