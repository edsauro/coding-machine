+            "teste": "pytest",
+        }
+    ],
+}
+
+
+@pytest.mark.parametrize("texto", [
+    json.dumps(PLANO),
+    "```json\n" + json.dumps(PLANO) + "\n```",
+    "Resposta do agente:\n" + json.dumps(PLANO) + "\nFim.",
+])
+def test_parseia_os_formatos_tolerados(texto):
+    plano = parsear_plano(texto)
+
+    assert isinstance(plano, Plano)
+    assert isinstance(plano.tasks[0], TaskPlano)
+    assert plano.tasks[0].id == "T01"
+    assert plano.prompt_original == texto
+
+
+def test_recusa_texto_sem_json():
+    with pytest.raises(PlanoInvalido):
+        parsear_plano("não há um plano aqui")
+
+
+def test_recusa_json_sem_tasks():
+    with pytest.raises(PlanoInvalido):
+        parsear_plano(json.dumps({"titulo": "incompleto"}))
+
+
+def test_ignora_objeto_json_irrelevante_no_texto_explicativo():
+    texto = "Metadados: {}\nPlano gerado:\n" + json.dumps(PLANO)
+
+    plano = parsear_plano(texto)
+
+    assert plano.titulo == "Sprint de teste"
