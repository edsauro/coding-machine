  "veredito": "APPROVE" | "REQUEST_CHANGES" | "REJECT",
  "confianca": 0.0,
  "criterios_atendidos": [{"criterio": "...", "atende": true, "evidencia": "..."}],
  "findings": [{"severidade": "alta|media|baixa", "arquivo": "...", "linha": 0, "descricao": "...", "correcao_sugerida": "..."}],
