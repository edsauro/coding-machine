diff --git a/autodev/planner.py b/autodev/planner.py
new file mode 100644
index 0000000..80987ac
--- /dev/null
+++ b/autodev/planner.py
@@ -0,0 +1,135 @@
+from __future__ import annotations
+
+import json
+import os
+import re
+import unicodedata
+from dataclasses import dataclass, field
+from pathlib import Path
+
+from . import agents
+from .config import Config, ordem_topologica
+from .errors import FailureClass
+from .plan_prompt import montar_prompt_plano
+
+PALAVRAS_VAGAS = ("melhorar", "otimizar", "refatorar", "revisar", "ajustar")
+
+
+class PlanoInvalido(ValueError):
+    pass
+
+
+class SprintJaExiste(FileExistsError):
+    pass
+
+
+class CotaEsgotada(RuntimeError):
+    pass
+
+
+@dataclass
+class TaskPlano:
+    id: str
+    titulo: str
+    criterios: list[str]
+    deps: list[str] = field(default_factory=list)
+    agente: str = "codex"
+    teste: str = ""
+
+
+@dataclass
+class Plano:
+    titulo: str
+    objetivo: str
+    repositorio: dict | str
+    tasks: list[TaskPlano]
+    prompt_original: str = ""
+
+
+def _objeto_json(texto: str) -> dict:
+    candidatos = [texto]
+    candidatos += re.findall(r"```(?:json)?\s*(\{.*?\})\s*```", texto, re.S)
+    decoder = json.JSONDecoder()
+    for candidato in candidatos:
+        try:
+            obj, _ = decoder.raw_decode(candidato.lstrip())
+            if isinstance(obj, dict):
+                return obj
+        except (json.JSONDecodeError, ValueError):
+            pass
+    for match in re.finditer(r"\{", texto):
+        try:
+            obj, _ = decoder.raw_decode(texto[match.start():])
+            if isinstance(obj, dict):
+                return obj
+        except json.JSONDecodeError:
+            continue
+    raise PlanoInvalido(f"resposta sem JSON reconhecivel: {texto[:200]}")
+
+
+def parsear_plano(texto: str) -> Plano:
+    obj = _objeto_json(texto)
+    if "tasks" not in obj:
+        raise PlanoInvalido("JSON do plano sem a chave tasks")
+    try:
+        tasks = [TaskPlano(id=t["id"], titulo=t["titulo"],
+                           criterios=t["criterios"], deps=t.get("deps", []),
+                           agente=t.get("agente", "codex"), teste=t.get("teste", ""))
+                 for t in obj["tasks"]]
+        return Plano(obj.get("titulo", ""), obj.get("objetivo", ""),
+                     obj.get("repositorio", {}), tasks)
+    except (KeyError, TypeError) as exc:
+        raise PlanoInvalido(f"estrutura de task invalida: {exc}") from exc
+
+
+def validar_plano(plano: Plano) -> list[str]:
+    erros = []
+    if not plano.tasks:
+        erros.append("plano sem tasks")
+    ids = [t.id for t in plano.tasks]
+    if len(ids) != len(set(ids)):
+        erros.append("ids duplicados")
+    conhecidos = set(ids)
+    for task in plano.tasks:
+        if not task.criterios:
+            erros.append(f"{task.id} sem criterios")
+        for dep in task.deps:
+            if dep not in conhecidos:
+                erros.append(f"{task.id} depende de {dep}, que nao existe")
+        for i, criterio in enumerate(task.criterios):
+            if any(p in criterio.lower() for p in PALAVRAS_VAGAS) and not re.search(r"(?:\.|/|pytest|python\s*3|npm\s+test|make\s+test)", criterio, re.I):
+                erros.append(f"{task.id} criterio {i} vago")
+    try:
+        ordem_topologica({"tasks": [{"id": t.id, "deps": t.deps} for t in plano.tasks]})
+    except ValueError as exc:
+        erros.append(str(exc))
+    return erros
+
+
+def validar_e_ordenar(plano: Plano) -> list[list[str]]:
+    erros = validar_plano(plano)
+    if erros:
+        raise PlanoInvalido("plano invalido:\n" + "\n".join(erros))
+    return ordem_topologica({"tasks": [{"id": t.id, "deps": t.deps} for t in plano.tasks]})
+
+
+def _sprint_id(titulo: str) -> str:
+    bruto = unicodedata.normalize("NFKD", titulo).encode("ascii", "ignore").decode()
+    return re.sub(r"[^A-Z0-9]+", "-", bruto.upper()).strip("-")[:60] or "PLANO"
+
+
+def planejar(raiz: Path, prompt_usuario: str, agente: str) -> Plano:
+    prompt = montar_prompt_plano(prompt_usuario)
+    sid = _sprint_id(prompt_usuario)
+    log = Path(raiz) / ".autodev" / "sprints" / sid / "logs" / f"plano-{agente}.log"
+    config_dir = Path(raiz) / ".autodev" / "config"
+    cfg = Config.carregar(config_dir) if config_dir.exists() else Config.carregar()
+    resultado = agents.invocar(agents.Invocacao(
+        agente=agente, prompt=prompt, worktree=str(raiz), log_path=str(log),
+        fake_script=os.environ.get("AUTODEV_FAKE_SPEC")), cfg)
+    if resultado.failure_class == FailureClass.CODEX_QUOTA.value:
+        raise CotaEsgotada("cota do Codex esgotada")
+    plano = parsear_plano(resultado.stdout)
+    plano.prompt_original = prompt_usuario
+    validar_e_ordenar(plano)
+    return plano
